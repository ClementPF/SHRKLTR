{
  "name": "sharkulator",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/backend",
    "apps/mobile"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "validate": "npm run lint && npm run typecheck && npm test && npm run e2e:smoke",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:serve": "npm exec -w apps/backend -- tsx e2e/server.ts",
    "e2e:stop": "npm exec -w apps/backend -- tsx e2e/stop.ts"
    "prod": "docker compose -f docker-compose.prod.yml --env-file .env.production",
    "prod:lan": "docker compose -f docker-compose.prod.yml -f docker-compose.lan.yml --env-file .env.production",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
