# Backend configuration. Copy to .env and fill in the secrets (init.sh does this automatically).
PORT=3100
APP_ENV=development
# Inside docker compose the api reaches the db service on its internal port.
DATABASE_URL=postgres://sharkulator:sharkulator@db:5432/sharkulator_dev
# Host-run tests use the published port 5433.
TEST_DATABASE_URL=postgres://sharkulator:sharkulator@localhost:5433/sharkulator_test
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=<generate-random-32-byte-hex>
JWT_REFRESH_SECRET=<generate-random-32-byte-hex>
DEV_AUTH_SECRET=<generate-random-32-byte-hex>
GOOGLE_CLIENT_ID=686477747885-1km1tuodinj4bp2vuhher7v8lo95rr7r.apps.googleusercontent.com
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# Web-application client secret for the server-side Google code exchange (POST /auth/google/code).
# Paste the real value into .env; init.sh never fills it. SERVER-ONLY: never commit it and never
# ship it to the mobile app. While unset, POST /auth/google/code answers 503.
# GOOGLE_CLIENT_SECRET=<paste-web-application-client-secret>
# Google token endpoint + accepted redirect URIs for the code exchange (safe defaults).
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_REDIRECT_ALLOWLIST=http://localhost:8081
# Browser origins allowed by CORS (comma-separated exact matches).
CORS_ORIGINS=http://localhost:8081
PUSH_URL=https://exp.host/--/api/v2/push/send
