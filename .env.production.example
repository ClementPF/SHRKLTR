# Production settings for docker-compose.prod.yml. Copy to .env.production (gitignored), fill
# in every value, then run: npm run prod -- up -d --build
# Generate each secret with: openssl rand -hex 32

# Public hostnames routed by the Cloudflare Tunnel (app -> http://web:80, api -> http://api:3100).
APP_HOSTNAME=app.example.com
API_HOSTNAME=api.example.com
# Cloudflare Zero Trust > Networks > Tunnels > your tunnel: the token from the connector install command.
CLOUDFLARE_TUNNEL_TOKEN=

# Hex only: it is embedded in the API's DATABASE_URL.
POSTGRES_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Required by config validation; /auth/dev-token is never registered when APP_ENV=production.
DEV_AUTH_SECRET=

GOOGLE_CLIENT_ID=686477747885-1km1tuodinj4bp2vuhher7v8lo95rr7r.apps.googleusercontent.com
# Web-application client secret. Server-only: never commit it.
GOOGLE_CLIENT_SECRET=

LOG_LEVEL=info
